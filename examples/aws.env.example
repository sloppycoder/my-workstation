# Per-VM settings for an AWS workstation.
# Copy to ~/.config/station-vm/<vm-name>.env (file name = VM name) and edit.
# provision-vm/scripts/register.sh writes this file at the end of provisioning;
# the vm-lifecycle scripts read it. Never commit the real file.
# Plain KEY=VALUE lines (it is sourced by bash): no spaces around '=', quote values with spaces.

NAME=myvm                    # must equal the file name (without .env) and the instance's Name tag
PROVIDER=aws
SSH_USER=aidev               # user created by the Ansible role
SSH_KEY=/Users/you/.ssh/id_ed25519   # absolute path of the PRIVATE key

REGION=us-west-2
SUBNET_ID=subnet-0123456789abcdef0          # public subnet the VM is launched into
SECURITY_GROUP_ID=sg-0123456789abcdef0      # <name>-sg from ensure_network.sh
KEY_NAME=my-ec2-keypair                     # existing EC2 key pair (matches SSH_KEY)
INSTANCE_TYPE=t3.large                      # used by create_vm.sh; override with --instance-type
PROFILE_NAME=ai-workstation-role            # IAM instance profile (default if omitted)

# Optional
#GUI=1                       # set if the VM has GNOME + DCV (opens 8443 in the security group)
#SEED_PREFIX=myproject       # seed AMI name prefix (default: the VM name)
