# Optional user-wide defaults: ~/.config/station-vm/defaults.env
# The provision-vm interview proposes these as answers; a per-VM <name>.env overrides them.
AWS_REGION=us-west-2          # Oregon: cheap; only pick e.g. ap-northeast-1 (Tokyo) on purpose
GCP_PROJECT=my-gcp-project-id
GCP_ZONE=us-west1-b
SSH_KEY=/Users/you/.ssh/id_ed25519
IMAGE_OS=debian13            # debian13 | ubuntu2404
ROOT_GB=20
#MACHINE_TYPE=e2-standard-2
#SEED_PREFIX=myproject
#SNAPSHOT_LOCATION=us
