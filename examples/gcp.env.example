# Per-VM settings for a GCP workstation.
# Copy to ~/.config/station-vm/<vm-name>.env (file name = VM name) and edit.
# provision-vm/scripts/register.sh writes this file at the end of provisioning;
# the vm-lifecycle scripts read it. Never commit the real file.
# Plain KEY=VALUE lines (it is sourced by bash): no spaces around '=', quote values with spaces.

NAME=myvm                    # must equal the file name (without .env) and the VM name
PROVIDER=gcp
SSH_USER=aidev               # user created by the Ansible role
SSH_KEY=/Users/you/.ssh/id_ed25519   # absolute path of the PRIVATE key (the .pub must sit next to it)

PROJECT=my-gcp-project-id    # gcloud project id
ZONE=us-west1-b
SERVICE_ACCOUNT=ai-workstation@my-gcp-project-id.iam.gserviceaccount.com   # from ensure_identity.sh
MACHINE_TYPE=e2-standard-2   # used by create_vm.sh; override with --machine-type

# Optional
#SEED_PREFIX=myproject       # seed snapshot name prefix (default: the VM name)
#SNAPSHOT_LOCATION=us        # GCS location for snapshots (cheaper multi-region; default: nearest)
